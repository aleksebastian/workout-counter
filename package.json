		"globals": "^17.5.0",
		"postcss": "^8.5.10",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.9",
		"vitest": "^4.1.5"
	},
